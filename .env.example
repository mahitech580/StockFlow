# Local development defaults (copy this file to .env)
APP_ENV=development
DATABASE_URL=sqlite:///./stockflow.db
# Replace with a unique random secret (32+ characters) in production.
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
TOKEN_TTL_HOURS=12
# Optional comma-separated origins if hosting a separate frontend.
CORS_ORIGINS=

# MySQL example:
# DATABASE_URL=mysql+pymysql://stockflow_user:change-me@localhost:3306/stockflow?charset=utf8mb4
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://stockflow_user:change-me@localhost:5432/stockflow
